{
  "name": "looser-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure dual-partner web enclave for business, passwords, reminders, health records, documents and emergency secret notes",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:push": "npm --prefix backend run prisma:push",
    "prisma:seed": "npm --prefix backend run prisma:seed",
    "clean": "rm -rf backend/dist frontend/dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
