# =============================================================================
# LOOSER VAULT — BACKEND ENVIRONMENT CONFIGURATION (.env)
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT SECURITY GUIDELINE:
# Never commit real passwords, secrets, or your master key to GitHub.
# In production cloud hosts (Render, Railway, VPS), inject these via the platform's
# Environment Variables settings dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# -----------------------------------------------------------------------------
# Port the Express HTTP & WebSocket server will listen on.
# In cloud hosts (Render, Railway, Heroku), PORT is injected automatically by the host.
PORT=5001

# Environment Mode: 'development' | 'production' | 'test'
# - development: Enables verbose stack traces and relaxed local origin checking.
# - production:  Enforces strict CORS, strips stack traces, optimizes error responses.
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Prisma requires a valid PostgreSQL connection string in DATABASE_URL.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public

# LOCAL DEVELOPMENT (e.g. docker-compose up or local PostgreSQL on port 5432):
DATABASE_URL="postgresql://postgres:postgrespassword2026!@localhost:5432/looser_vault?schema=public"

# PRODUCTION HOSTING EXAMPLES:
# -----------------------------
# Railway PostgreSQL:
#   DATABASE_URL="postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway"
#
# Render Managed PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@dpg-xxxxx-a.oregon-postgres.render.com/looser_vault?sslmode=require"
#
# Neon Serverless PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase PostgreSQL:
#   DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Optional granular DB parameters (used for reference or external migration scripts):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=looser_vault
DB_USER=postgres
DB_PASSWORD=postgrespassword2026!

# -----------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC KEYS & SECURITY SECRETS
# -----------------------------------------------------------------------------
# Generate secure, high-entropy secrets using OpenSSL in your terminal:
#   openssl rand -hex 32      -> generates 64-character hex key (for VAULT_MASTER_KEY)
#   openssl rand -base64 32   -> generates random 256-bit string (for JWT & REAUTH)

# JWT Session Authentication Secret:
# Used to sign session bearer tokens for partner login and API authorization.
JWT_SECRET="looser_vault_super_secure_jwt_secret_key_2026_x89f_change_me!"

# Token Validity Duration (e.g. 7d, 24h, 30d):
JWT_EXPIRES_IN="7d"

# Re-Authentication Secret:
# Issues temporary high-security tokens (valid 5 mins) when a user enters their
# password to unlock emergency notes, reveal bank accounts, or delete records.
REAUTH_SECRET="looser_vault_reauth_secret_key_99823_secure_change_me!"

# AES-256-GCM Vault Master Key:
# MUST BE EXACTLY 64 HEXADECIMAL CHARACTERS (32 bytes).
# Used to encrypt sensitive passwords, ATM card numbers, CVVs, and medical notes at rest.
# DO NOT LOSE THIS KEY! If changed in production, existing encrypted records cannot be decrypted.
# Run: openssl rand -hex 32
VAULT_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# -----------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins that can make API and Socket requests.
#
# LOCAL DEV:
#   http://localhost:3000 (Vite dev server)
#   http://localhost:5173 (alternative Vite dev port)
#
# PRODUCTION:
#   Add your production frontend domains:
#   CORS_ORIGIN="https://vault.yourdomain.com,https://looser-vault.vercel.app"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
