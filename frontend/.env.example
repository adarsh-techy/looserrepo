# =============================================================================
# LOOSER VAULT — FRONTEND ENVIRONMENT VARIABLES (.env)
# =============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# NOTE: In Vite, all environment variables accessible to the browser MUST be
# prefixed with VITE_. Never expose sensitive private keys or database passwords
# in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. API BACKEND URL
# -----------------------------------------------------------------------------
# MODE A: LOCAL DEVELOPMENT (Default)
# Leave this empty or set to /api. Vite's dev server (vite.config.ts) will
# automatically proxy requests to http://localhost:5001/api without CORS issues.
VITE_API_URL=/api

# MODE B: PRODUCTION HOSTING (e.g. Vercel, Netlify, Cloudflare Pages)
# When your frontend is deployed separately from your backend, specify the full
# URL to your backend API.
# Examples:
#   VITE_API_URL=https://api.yourdomain.com/api
#   VITE_API_URL=https://looser-backend.onrender.com/api
#   VITE_API_URL=https://looser-vault.railway.app/api

# -----------------------------------------------------------------------------
# 2. REAL-TIME WEBSOCKET (SOCKET.IO) URL
# -----------------------------------------------------------------------------
# MODE A: LOCAL DEVELOPMENT (Default)
# Leave this as / or empty. Vite proxies /socket.io to http://localhost:5001.
VITE_SOCKET_URL=/

# MODE B: PRODUCTION HOSTING
# When your backend is hosted separately, specify the root URL of your backend.
# Examples:
#   VITE_SOCKET_URL=https://api.yourdomain.com
#   VITE_SOCKET_URL=https://looser-backend.onrender.com
#   VITE_SOCKET_URL=https://looser-vault.railway.app

# -----------------------------------------------------------------------------
# 3. APPLICATION BRANDING & CUSTOMIZATION
# -----------------------------------------------------------------------------
VITE_APP_NAME="Looser Secure Vault"
VITE_APP_TAGLINE="Personal Enclave"
